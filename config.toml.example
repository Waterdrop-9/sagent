# Sagent 本地配置模板
# 复制为 config.toml 后按需修改：cp config.toml.example config.toml
# config.toml 已加入 .gitignore，不要提交真实 API Key。

[agent]
# 后续开发主用 opencode；claude 作为辅助验证。
runtime = "opencode"
# provider 决定走哪条协议：写成 anthropic 走 Anthropic Messages（/v1/messages），
# 其他名字一律走 OpenAI 兼容（/v1/chat/completions）。
# 本地 Anthropic 兼容模型示例：
#   provider = "anthropic"
#   base_url = "http://host.docker.internal:8000"   # 主机/子路径/完整端点均可，
#                                                   # 会自动归一化成 …/v1
provider = "deepseek"
# 留空表示使用底座默认模型。
model = "deepseek-flash"
# API Key 直接填写在本地 config.toml；config.toml 已被 gitignore。
api_key = "sk-替换为你的 DeepSeek API Key"
# 云端 DeepSeek 使用这个地址；本地 OpenAI-compatible 服务改成自己的地址。
base_url = "https://api.deepseek.com/v1"
# Agent 单次运行最长时间（秒）。
timeout = 3600
# 会话级重试：opencode 非零退出（provider 瞬时超时等）时复用同一 prompt
# 重跑整个会话的最大次数（默认 2；设 0 关闭）。启动竞态重试不受此控制。
session_retries = 2

# 外部 PoC 阶段默认关闭。启用时只读取 prompt，不执行生成的 PoC。
# 模板使用仓库内的 prompts/poc-stage.md；相对路径按 config.toml 所在目录解析。
# [poc]
# enabled = false
# prompt_file = "prompts/poc-stage.md"
